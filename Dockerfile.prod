# =====================================================================
#  صورة الإنتاج (Docker / Railway / Compose)
#
#  ملاحظات:
#  - لا نثبّت platform: يتكيف مع بنية المضيف (x86_64 أو arm64)
#  - لا يوجد Celery: عامل التوليد يعمل داخل عملية البوت (pipeline/jobs.py)
#  - نقطة الدخول الموحّدة في scripts/entrypoint.sh (bot افتراضيا)
# =====================================================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY . .

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:${PORT:-8000}/health || exit 1

# APP_ROLE=bot (افتراضي) · APP_ROLE=api للواجهة
CMD ["sh", "-c", "exec python -m app.bot"]
