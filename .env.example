# =====================================================================
#  ملف الإعدادات — انسخه إلى .env ثم املأ القيم
#  انسخ:  copy .env.example .env
# =====================================================================

# ===== Telegram =====
BOT_TOKEN=
# polling = يعمل محليا بلا دومين | webhook = للنشر
BOT_MODE=polling
# عند webhook: ضع نطاقك العام (HTTPS) وسيُبنى الرابط: WEBHOOK_URL/WEBHOOK_PATH
WEBHOOK_URL=
WEBHOOK_PATH=webhook
WEBHOOK_PORT=8443
# توكن سري اختياري للتحقق من أن التحديثات من تلجرام (يُنصح به)
WEBHOOK_SECRET=
# معرفات تلجرام للمشرفين (مفصولة بفاصلة)
ADMIN_IDS=

# ===== AI (OpenAI-compatible) =====
# الافتراضي موجّه لـLM Studio المحلي. لأي مزوّد سحابي بدّل القيم الأربع.
# LM Studio: شغّل الخادم (Developer ▸ Start Server) وفعّل "Max parallel requests" ≥ 4
#            ثم انسخ معرّف الموديل من تبويب الموديلات إلى AI_MODEL.
AI_BASE_URL=http://localhost:1234/v1
AI_API_KEY=lm-studio
AI_MODEL=local-model
# موديل أسرع للمخططات (اختياري). اتركه فارغا لاستخدام AI_MODEL.
AI_MODEL_FAST=
AI_TIMEOUT=300
AI_MAX_TOKENS=16384
# وضع JSON: auto (يجرّب json_object ثم json_schema ثم نص عادي) | json_object | json_schema | none
AI_JSON_MODE=auto
AI_MAX_RETRIES=3
# مثال سحابي:
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT=120
# AI_MAX_TOKENS=4096

# ===== الوضع المجاني (بدون بطاقة) — يُفعّل بدلا من AI_BASE_URL =====
# 1) اجعل AI_FREE_MODE=1 واترك AI_API_KEY فارغا.
# 2) املأ مفتاح مزوّد واحد على الأقل (كلها بخطط مجانية):
#    - Gemini:     https://aistudio.google.com/apikey   (حوالي 250 طلب/يوم لكل مفتاح)
#    - Groq:       https://console.groq.com/keys
#    - OpenRouter: https://openrouter.ai/keys           (موديلات :free)
AI_FREE_MODE=0
# ترتيب التجربة عند نفاد الحصة أو الفشل
AI_PROVIDER_ORDER=gemini,groq,openrouter
# ميزانية يومية إجمالية بالتوكنات لكل المزوّدين (0 = بلا سقف)
AI_DAILY_TOKEN_BUDGET=2000000
GEMINI_API_KEY=
# مفتاح ثانٍ اختياري من مشروع Google آخر لمضاعفة الحصة
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_RPM=10
GEMINI_RPD=1000
GEMINI_TPD=2000000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM=30
GROQ_RPD=1000
GROQ_TPD=200000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_RPM=20
OPENROUTER_RPD=50
OPENROUTER_TPD=0

# ===== Database / Cache =====
DATABASE_URL=postgresql+asyncpg://cyber:cyber@db:5432/cyberbot
REDIS_URL=redis://cache:6379/0
# حجم اتصالات قاعدة البيانات: (DB_POOL_SIZE + DB_MAX_OVERFLOW) لكل خدمة
# مهم على Railway: يجب أن يبقى أقل من max_connections الخاص بـ PostgreSQL
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# تدوير الاتصالات كل 30 دقيقة (الـ proxy يقطع الاتصالات الخاملة)
DB_POOL_RECYCLE=1800

# ===== Security =====
SECRET_KEY=change-me-with-a-long-random-string
ACCESS_TOKEN_TTL_MIN=10080
JWT_ALGORITHM=HS256

# ===== App =====
ENV=dev
LOG_LEVEL=INFO
# رابط تطبيق Mini App (يخدم من /app) — اتركه فارغا ليعمل البوت بدون زر التطبيق
MINIAPP_URL=
API_BASE_URL=
# ===== أدوات اختبار الويب (Burp-lite) =====
# النطاقات المسموح استهدافها بالـRepeater/Fuzzer (مفصولة بفاصلة). اتركه للـlocalhost
PROXY_ALLOWED_HOSTS=localhost,127.0.0.1
PROXY_TIMEOUT=20

# ===== Content generation / verification =====
# عدد أكواد كل درس، وعدد الاستخدامات الموثّقة لكل كود (موسوعة الأكواد)
GEN_MIN_CODES=6
GEN_FAST_CODES=4
GEN_FAST_MIN_CHARS=2800
GEN_MIN_CHARS=4000
GEN_MIN_QUESTIONS=8
GEN_MIN_USAGES=8
# إثراء كل كود بتشريح سطري + جميع استخداماته (يستهلك نداءات AI إضافية)
GEN_ENRICH_ATLAS=1
GEN_ATLAS_BATCH=5
GEN_MAX_REPAIRS=3
GEN_CONCURRENCY=2
# تنفيذ الأكواد فعليا في الـSandbox (تحقق صارم). اجعله 0 للتحقق النحوي فقط.
VERIFY_EXEC=1
# تنفيذ محلي عند غياب Docker (بيئة نظيفة + حدود موارد + مهلة، بلا عزل شبكي).
SANDBOX_LOCAL=1
VERIFY_CODE_CONCURRENCY=4
SANDBOX_MEM_MB=256
SANDBOX_CPUS=0.5
SANDBOX_TIMEOUT=10
# نشر تلقائي بعد نجاح التحقق (0 = يبقى verified للمراجعة اليدوية)
AUTO_PUBLISH=0

# ===== الحجم والمخططات (Outline-first + Lazy) =====
# 200 درس لكل لغة = 10 مراحل × 20 درسا (48 لغة = 9600 درس)
GEN_STAGES=10
GEN_LESSONS_PER_STAGE=20
# بناء مخطط اللغة (عناوين الدروس فقط) تلقائيا قبل توليد المحتوى الكامل
GEN_OUTLINE_ENABLED=1
# توليد الدرس الكامل عند فتحه أول مرة (Lazy)
GEN_LAZY_ON_OPEN=1
# عند إتمام مخطط لغة: سخّن أول N درس بتوليدها كاملة مسبقا
GEN_WARM_LESSONS=0
GEN_PREBUILD_ON_OPEN=1
GEN_PREBUILD_MAX=0
GEN_PREBUILD_PRIORITY=2
AI_RESERVE_PCT=25
AI_RESERVE_RPD=80
# عدد مهام التوليد المتوازية (يتطلب تفعيل Max parallel requests في LM Studio)
GEN_WORKER_CONCURRENCY=2
# كل كم ثانية يستطلع العامل الطابور
GEN_QUEUE_POLL=5
# أقصى محاولات لكل مهمة، ومهلة المهمة الواحدة بالثواني
GEN_JOB_MAX_ATTEMPTS=3
GEN_LESSON_TIMEOUT=1800
# سقف مهام التوليد في الطابور (queued+running). 0 = بلا سقف. يحمي الحصة المجانية.
GEN_QUEUE_MAX=400
# ===== بيئات الهدف (Targets) =====
# روابط أهداف خارجية بدلا من تشغيل حاويات محليا. صيغة: slug=url مفصولة بفاصلة.
# أمثلة: juice-shop=https://<your-hosted-juice-shop>,dvwa=https://<your-hosted-dvwa>
# اتركه فارغا للنمط الموجّه (حل المهام بدون حاوية).
TARGET_EXTERNAL_URLS=

# =====================================================================
#  تشغيل البوت فقط (بدون Docker) — الأسرع للبدء
#  - استبدل DATABASE_URL أعلاه بالسطر التالي
#  - اضبط BOT_TOKEN و AI_* (LM Studio) أعلاه
#  ثم شغّل:  .\run_bot.ps1
# =====================================================================
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# VERIFY_EXEC=0
# SANDBOX_LOCAL=0
