# =============================================================================
# Cyber Academy Bot - Production Environment Template
# Copy to .env.prod and fill in your actual values
# =============================================================================

# ===== Telegram =====
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
BOT_MODE=webhook
WEBHOOK_URL=https://yourbot.duckdns.org
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8443
WEBHOOK_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32

ADMIN_IDS=YOUR_TELEGRAM_NUMERIC_ID

# ===== AI (Free Tier - Gemini) =====
AI_FREE_MODE=1
AI_PROVIDER_ORDER=gemini,groq,openrouter
AI_DAILY_TOKEN_BUDGET=2000000
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_FROM_AISTUDIO
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_RPM=10
GEMINI_RPD=1000
GEMINI_TPD=2000000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM=30
GROQ_RPD=1000
GROQ_TPD=200000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_RPM=20
OPENROUTER_RPD=50
OPENROUTER_TPD=0

# OpenAI-compatible (used when AI_FREE_MODE=0)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=120
AI_MAX_TOKENS=8192
AI_JSON_MODE=auto
AI_MAX_RETRIES=3

# ===== Database / Cache =====
DATABASE_URL=postgresql+asyncpg://cyber:STRONG_DB_PASSWORD@db:5432/cyberbot
REDIS_URL=redis://redis:6379/0

# ===== Security =====
SECRET_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_TTL_MIN=10080
JWT_ALGORITHM=HS256

# ===== App =====
ENV=prod
LOG_LEVEL=INFO
MINIAPP_URL=

# ===== Content Generation / Verification =====
VERIFY_EXEC=0
SANDBOX_LOCAL=1
GEN_MIN_CODES=6
GEN_FAST_CODES=4
GEN_FAST_MIN_CHARS=2800
GEN_MIN_CHARS=4000
GEN_MIN_QUESTIONS=8
GEN_MIN_USAGES=8
GEN_ENRICH_ATLAS=1
GEN_ATLAS_BATCH=5
GEN_MAX_REPAIRS=3
GEN_CONCURRENCY=2
VERIFY_CODE_CONCURRENCY=4
SANDBOX_MEM_MB=256
SANDBOX_CPUS=0.5
SANDBOX_TIMEOUT=10
AUTO_PUBLISH=0

# Scale (Outline-first + Lazy)
GEN_STAGES=10
GEN_LESSONS_PER_STAGE=20
GEN_OUTLINE_ENABLED=1
GEN_LAZY_ON_OPEN=1
GEN_WARM_LESSONS=0
GEN_PREBUILD_ON_OPEN=1
GEN_PREBUILD_MAX=0
GEN_PREBUILD_PRIORITY=2
AI_RESERVE_PCT=25
GEN_WORKER_CONCURRENCY=2
GEN_QUEUE_POLL=5
GEN_JOB_MAX_ATTEMPTS=3
GEN_LESSON_TIMEOUT=1800
GEN_QUEUE_MAX=400
# ===== Targets (External URLs) =====
TARGET_EXTERNAL_URLS=

# ===== Web Tools (Burp-lite) =====
PROXY_ALLOWED_HOSTS=localhost,127.0.0.1
PROXY_TIMEOUT=20